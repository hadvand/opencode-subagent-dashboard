{
  "name": "opencode-subagent-dashboard",
  "version": "0.1.0",
  "description": "OpenCode v2 TUI dashboard for tracking subagent progress, context usage, and recent activity in real time.",
  "type": "module",
  "license": "MIT",
  "author": "hadvand (https://github.com/hadvand)",
  "homepage": "https://github.com/hadvand/opencode-subagent-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadvand/opencode-subagent-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/hadvand/opencode-subagent-dashboard/issues"
  },
  "keywords": [
    "opencode-plugin",
    "opencode",
    "opencode-tui",
    "tui",
    "subagent",
    "subagents",
    "dashboard",
    "agents",
    "orchestration",
    "observability",
    "context"
  ],
  "exports": {
