  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.17",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
